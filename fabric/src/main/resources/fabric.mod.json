{
  "schemaVersion": 1,
  "id": "lodestone",
  "version": "${version}",
  "name": "Lodestone",
  "description": "A library containing various utilities.",
  "authors": [
    "Lodestar"
  ],
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "team.lodestar.lodestone.fabric.LodestoneFabric"
    ],
    "client": [
      "team.lodestar.lodestone.fabric.LodestoneFabricClient"
    ],
    "fabric-datagen": [
      "team.lodestar.lodestone.fabric.LodestoneFabricDataGeneratorEntrypoint"
    ],
    "preLaunch": [
      "team.lodestar.lodestone.fabric.LodestoneFabricDatagenBootstrap"
    ]
  },
  "mixins": [
    "lodestone.mixins.json",
    "lodestone.fabric.mixins.json",
    "lodestone.fabric.shader.mixins.json",
    "lodestone.fabric.gameplay.mixins.json"
  ],
  "accessWidener": "lodestone.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
